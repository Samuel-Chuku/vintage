# systemd unit for vintage-api. Install:
#   sudo install -m 644 vintage-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now vintage-api
# Paths assume the files live in /home/ubuntu/vintage (bin/, registry/, cache/). Listens on localhost
# only: put a TLS reverse proxy in front (see Caddyfile.example).

[Unit]
Description=Vintage HTTP verifier
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/vintage
ExecStart=/home/ubuntu/vintage/bin/vintage-api \
    --network main \
    --listen 127.0.0.1:8080 \
    --registry /home/ubuntu/vintage/registry \
    --cache /home/ubuntu/vintage/cache/cache.sqlite \
    --allow-origin *
Restart=on-failure
RestartSec=5

# Hardening: read-only system and home, except the cache directory.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/vintage/cache
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryMax=512M

[Install]
WantedBy=multi-user.target
